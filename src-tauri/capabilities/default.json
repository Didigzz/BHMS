{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:scope-appdata-recursive"
  ]
}
